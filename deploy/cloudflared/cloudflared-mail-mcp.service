# /etc/systemd/system/cloudflared-mail-mcp.service
[Unit]
Description=Cloudflare Tunnel for claude-mail-mcp
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
User=cloudflared
Group=cloudflared
ExecStart=/usr/bin/cloudflared --no-autoupdate --config /etc/cloudflared/mail-mcp.yml tunnel run
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
CapabilityBoundingSet=
ReadOnlyPaths=/etc/cloudflared

[Install]
WantedBy=multi-user.target
