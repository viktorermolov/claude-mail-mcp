{
  "name": "claude-mail-mcp",
  "version": "0.7.0",
  "description": "Self-hosted IMAP-only MCP connector for Claude: read, search, text drafts, move, flags, trash — no sending, no permanent deletion. Auth via Cloudflare Access Managed OAuth.",
  "license": "MIT",
  "author": "Viktor Ermolov (fork)",
  "homepage": "https://github.com/viktorermolov/claude-mail-mcp#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/viktorermolov/claude-mail-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/viktorermolov/claude-mail-mcp/security/advisories/new"
  },
  "keywords": [
    "claude",
    "anthropic",
    "mcp",
    "model-context-protocol",
    "imap",
    "email",
    "self-hosted",
    "connector"
  ],
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "claude-mail-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    ".env.example",
    "deploy",
    "Dockerfile",
    "compose.yaml"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "clean": "rm -rf dist",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "express": "^5.0.1",
    "fast-xml-parser": "^5.11.1",
    "html-to-text": "^10.0.1",
    "ical.js": "^2.2.1",
    "imapflow": "^1.0.180",
    "jose": "^6.2.12",
    "libqp": "^2.1.2",
    "mailparser": "^3.7.2",
    "nodemailer": "^10.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/html-to-text": "^9.0.4",
    "@types/libqp": "^1.1.3",
    "@types/mailparser": "^3.4.5",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^8.0.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "contributors": [
    "Markus Stöger <hi@markusstoeger.com> (https://markusstoeger.com)"
  ]
}
