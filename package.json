{
  "name": "claude-mail-mcp",
  "version": "0.3.0",
  "description": "Self-hosted IMAP-only MCP connector for Claude: read, search, drafts, move, flags, trash \u2014 no sending, no expunge. Auth via Cloudflare Access Managed OAuth.",
  "license": "MIT",
  "author": "Markus St\u00f6ger <hi@markusstoeger.com> (https://markusstoeger.com)",
  "homepage": "https://markusstoeger.com/repos#claude-mail-mcp",
  "repository": {
    "type": "git",
    "url": "https://github.com/maxx3250/claude-mail-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/maxx3250/claude-mail-mcp/issues"
  },
  "keywords": [
    "claude",
    "anthropic",
    "mcp",
    "model-context-protocol",
    "imap",
    "email",
    "self-hosted",
    "connector"
  ],
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "claude-mail-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    ".env.example",
    "deploy",
    "Dockerfile",
    "compose.yaml"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "clean": "rm -rf dist",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "express": "^5.0.1",
    "imapflow": "^1.0.180",
    "jose": "^6.2.12",
    "mailparser": "^3.7.2",
    "nodemailer": "^10.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/mailparser": "^3.4.5",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^8.0.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
