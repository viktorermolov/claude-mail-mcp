# claude-mail-mcp — copy to .env next to compose.yaml. Mailbox credentials
# live in ./secrets/accounts.json (see deploy/accounts.example.json), never here.

# Host uid/gid that owns ./secrets; the container runs as this user.
MAILMCP_UID=
MAILMCP_GID=

# debug | info | warn | error
LOG_LEVEL=info

# --- Cloudflare Access (Managed OAuth) ---
# Zero Trust team domain and the Application Audience (AUD) tag of the
# self-hosted Access application that fronts the tunnel hostname.
CF_ACCESS_TEAM_DOMAIN=yourteam.cloudflareaccess.com
CF_ACCESS_AUD=
# Comma-separated identities allowed to use the connector.
ALLOWED_EMAILS=you@example.com

# --- Calendars (read-only) ---
# on: iCloud accounts also read their calendars over CalDAV with the same
# app-specific password. Default IANA time zone for calendar dates.
CALENDAR_ICLOUD=off
CALENDAR_TIMEZONE=UTC
