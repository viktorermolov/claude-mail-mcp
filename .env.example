# claude-mail-mcp — transport-level config. Mailbox credentials live in
# ACCOUNTS_FILE (see deploy/accounts.example.json), never here.

# Loopback only: the sole way in is the local cloudflared connector.
HOST=127.0.0.1
PORT=3220
# debug | info | warn | error
LOG_LEVEL=info

ACCOUNTS_FILE=/etc/claude-mail-mcp/accounts.json

# --- Cloudflare Access (Managed OAuth) ---
# Zero Trust team domain and the Application Audience (AUD) tag of the
# self-hosted Access application that fronts the tunnel hostname.
CF_ACCESS_TEAM_DOMAIN=yourteam.cloudflareaccess.com
CF_ACCESS_AUD=
# Comma-separated identities allowed to use the connector.
ALLOWED_EMAILS=you@example.com
